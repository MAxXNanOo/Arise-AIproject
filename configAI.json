{
  "camera": {
    "device_index": 0,
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "audio": {
    "device_index": null,
    "sample_rate": 16000,
    "chunk_duration_sec": 0.975
  },
  "web_alert": {
    "enabled": true,
    "url": "http://localhost:5500/api/alerts",
    "timeout_sec": 2.0
  },
  "event_correlation": {
      "enabled": true,

      "rules": {
        "fight": {
          "enabled": true,
          "cooldown_sec": 10,

          "signals": {
            "action": {
              "source": "action",
              "classes": [
                "boxing"
              ]
            },

            "people": {
              "source": "people",
              "min_people": 2
            }
          }
        },

        "gunshot": {
          "enabled": true,
          "cooldown_sec": 10,

          "signals": {
            "object": {
              "source": "object",
              "classes": [
                "handgun"
              ]
            },

            "audio": {
              "source": "audio",
              "classes": [
                "0"
              ]
            }
          }
        },

        "panic": {
          "enabled": true,
          "cooldown_sec": 10,

          "signals": {
            "action": {
              "source": "action",
              "classes": [
                "running"
              ]
            },

            "people": {
              "source": "people",
              "min_people": 2
            },

            "audio": {
              "source": "audio",
              "classes": [
                "2"
              ]
            }
          }
        }
      }
    },
  "models": {
    "object_detector": {
      "type": "yolo_detect",
      "path": "models/object_detection/weights/best.pt",
      "conf_threshold": 0.45,
      "classes": {
        "0": {
          "name": "handgun",
          "alert": true,
          "threshold": 0.8
        },
        "1": {
          "name": "knife",
          "alert": true,
          "threshold": 0.8
        },
        "2": {
          "name": "phone",
          "alert": false,
          "threshold": 0.0
        },
        "3": {
          "name": "person",
          "alert": false,
          "threshold": 0.0
        },
        "4": {
          "name": "waterBottle",
          "alert": false,
          "threshold": 0.0
        }
      }
    },
    "pose_estimator": {
      "type": "yolo_pose",
      "path": "yolo11n-pose.pt",
      "conf_threshold": 0.4,
      "num_keypoints": 17
    },
    "action_classifier": {
      "type": "gru",
      "path": "models/action_classifier/GRU/best_action_gru.pth",
      "sequence_length": 30,
      "classes": {
        "0": {
          "name": "boxing",
          "alert": true,
          "threshold": 0.8
        },
        "1": {
          "name": "handclapping",
          "alert": false,
          "threshold": 0.0
        },
        "2": {
          "name": "handwaving",
          "alert": false,
          "threshold": 0.0
        },
        "3": {
          "name": "jogging",
          "alert": false,
          "threshold": 0.0
        },
        "4": {
          "name": "running",
          "alert": true,
          "threshold": 0.6
        },
        "5": {
          "name": "walking",
          "alert": false,
          "threshold": 0.0
        }
      }
    },
    "audio_classifier": {
      "type": "yamnet",
      "path": "models/audio_classifier/current/audio_classifier.pkl",
      "class_map_path": null,
      "classes": {
        "0": {
          "alert": true,
          "threshold": 0.35
        },
        "1": {
          "alert": false,
          "threshold": 0.0
        },
        "2": {
          "alert": true,
          "threshold": 0.3
        }
      }
    }
  }
}